{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",


  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/identity/{**catch-all}" }
      },



      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },



      "loyalty-route": {
        "ClusterId": "loyalty-cluster",
        "Match": { "Path": "/api/loyalty/{**catch-all}" }
      },


      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/inventory/{**catch-all}" }
      }


    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "dest1": { "Address": "https://localhost:5001" }
        }
      },


      "orders-cluster": {
        "Destinations": {
          "dest1": { "Address": "https://localhost:5002" }
        }
      },


      "loyalty-cluster": {
        "Destinations": {
          "dest1": { "Address": "https://localhost:5003" }
        }
      },


      "inventory-cluster": {
        "Destinations": {
          "dest1": { "Address": "https://localhost:5004" }
        }
      }


    }
  }
}