# ==============================================================================
# BlackBeam Microservices Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` in the root or corresponding service directories 
# and update the values before running the application.
# Do NOT commit your actual `.env` file to version control.

# ------------------------------------------------------------------------------
# Global Settings (Used across multiple services)
# ------------------------------------------------------------------------------
# Secret key for JWT signature. Must be long and complex (e.g., 256-bit or more).
JwtSettings__Secret=
JwtSettings__Issuer=

# ------------------------------------------------------------------------------
# BlackBeam.Services.Identity
# ------------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=BlackBeam_Identity_DB;Uid=root;Pwd=;

# ------------------------------------------------------------------------------
# BlackBeam.Services.Inventory
# ------------------------------------------------------------------------------
# Uses Global JwtSettings
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=BlackBeam_Inventory_DB;Uid=root;Pwd=;

# ------------------------------------------------------------------------------
# BlackBeam.Services.Loyalty
# ------------------------------------------------------------------------------
# Uses Global JwtSettings
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3306;Database=BlackBeam_Loyality_DB;Uid=root;Pwd=;

# ------------------------------------------------------------------------------
# BlackBeam.Services.Orders
# ------------------------------------------------------------------------------
# Uses Global JwtSettings
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=BlackBeam_Order_Db;Uid=root;Pwd=;

# Stripe Configuration
Stripe__SecretKey=
Stripe__WebhookSecret=
